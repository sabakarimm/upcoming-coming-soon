{
  "name": "upcoming-coming-soon",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  // Custom domains whatsupcomi.ng and www.whatsupcomi.ng are already
  // attached to this Worker in the dashboard. Omitting routes here
  // updates the script without touching DNS.
  "routes": [
    { "pattern": "whatsupcomi.ng", "custom_domain": true },
    { "pattern": "www.whatsupcomi.ng", "custom_domain": true }
  ]
}
